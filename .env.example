# ---------------------------------------------------------------------------
# MoneyTear API - example environment
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database (Supabase PostgreSQL) ----------------------------------------
# Use the *pooler* host: `db.<project-ref>.supabase.co` is IPv6-only on Supabase
# and unreachable from IPv4-only networks.
#   Direct:  postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#   Pooler:  postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=your-database-password
DB_NAME=postgres
DB_SSL=true
# Supabase serves TLS with a certificate chain your Node build may not trust;
# keep this false unless you have configured the CA.
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_SIZE=10

# --- Supabase Auth ---------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co (no trailing slash).
SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable (anon) key. Safe to ship to the mobile client; the backend does
# not use it to verify tokens - it is validated for format only.
SUPABASE_ANON_KEY=sb_publishable_replace_me

# Legacy HS256 signing secret. Optional. Only needed if the project still signs
# access tokens symmetrically; leave blank when using asymmetric (JWKS) keys.
# SUPABASE_JWT_SECRET=

# Expected `aud` claim on access tokens.
AUTH_JWT_AUDIENCE=authenticated

# --- Authentication & PIN policy ------------------------------------------
# How recently the caller must have signed in for sensitive operations
# (PIN setup and PIN reset). Seconds.
AUTH_RECENT_AUTH_WINDOW_SECONDS=300
# Failed PIN attempts before a temporary lockout.
AUTH_PIN_MAX_ATTEMPTS=5
# Lockout duration once the attempt budget is exhausted. Seconds.
AUTH_PIN_LOCK_SECONDS=900
# Lifetime of the server-side PIN-unlock state created by a successful
# verification. Seconds.
AUTH_PIN_UNLOCK_TTL_SECONDS=300

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
# Stricter per-IP budget for PIN endpoints. Must stay below RATE_LIMIT_MAX.
PIN_RATE_LIMIT_MAX=10

# --- HTTP ------------------------------------------------------------------
# Comma-separated allow-list of permitted browser origins, e.g.
# http://localhost:8081,https://app.example.com
# Leave empty to disable cross-origin requests entirely.
CORS_ORIGINS=

# --- Documentation ---------------------------------------------------------
# Set to false in production and expose the docs through an internal-only
# ingress instead. An obscure URL is not access control.
SWAGGER_ENABLED=true

# --- Observability (existing @nestjs/observe integration) -------------------
OBSERVE_APP_KEY=your_observe_app_key
OBSERVE_APP_SECRET=your_observe_app_secret