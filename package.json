{
  "name": "money-tear-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run start:prod",
    "start:dev": "npm run build && nest start --watch --exec \"node --env-file-if-exists=.env --import ./dist/runtime/register-alias.js\"",
    "start:debug": "npm run build && node --env-file-if-exists=.env --inspect --import ./dist/runtime/register-alias.js dist/main.js",
    "start:prod": "node --env-file-if-exists=.env --import ./dist/runtime/register-alias.js dist/main.js",
    "lint": "oxlint --type-aware src/",
    "migration:run": "npm run build && node --env-file-if-exists=.env --import ./dist/runtime/register-alias.js dist/database/cli.js run",
    "migration:revert": "npm run build && node --env-file-if-exists=.env --import ./dist/runtime/register-alias.js dist/database/cli.js revert",
    "migration:show": "npm run build && node --env-file-if-exists=.env --import ./dist/runtime/register-alias.js dist/database/cli.js show",
    "migration:diff": "npm run build && node --env-file-if-exists=.env --import ./dist/runtime/register-alias.js dist/database/cli.js diff"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@node-rs/argon2": "^2.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.2"
  }
}
